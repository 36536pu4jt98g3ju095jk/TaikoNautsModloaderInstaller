<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TaikoNautsModloaderInstaller</AssemblyName>
    <RootNamespace>TaikoNautsModloaderInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>TaikoNauts ModLoader Installer</Product>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- The ModLoader package is placed here by scripts\build.ps1 and embedded in the executable. -->
  <ItemGroup Condition="Exists('Embedded\ModLoader.zip')">
    <EmbeddedResource Include="Embedded\ModLoader.zip" LogicalName="ModLoader.zip" />
    <EmbeddedResource Include="Embedded\ModLoader.version" LogicalName="ModLoader.version" />
  </ItemGroup>
</Project>
